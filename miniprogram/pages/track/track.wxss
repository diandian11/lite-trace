/* 轨迹详情页 */
.track-map {
  width: 100%;
  height: 560rpx;
  border-radius: 20rpx;
}
.map-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  margin: 12rpx 0 4rpx;
}
.map-full {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  border-radius: 0;
}
.fm-top {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 32rpx 24rpx 32rpx;
  background: linear-gradient(rgba(17,24,39,0.82), rgba(17,24,39,0.45) 70%, rgba(0,0,0,0));
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.fm-exit {
  background: rgba(17,24,39,0.88);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
}
.fm-dist {
  background: rgba(17,24,39,0.72);
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 800;
  margin-top: 20rpx;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
}
.fm-time {
  background: rgba(17,24,39,0.66);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  margin-top: 14rpx;
  padding: 8rpx 22rpx;
  border-radius: 18rpx;
}

/* 速度热力图例 */
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 14rpx 0 0;
}
.hl-seg {
  width: 44rpx;
  height: 12rpx;
  border-radius: 6rpx;
}
.hl-label {
  font-size: 22rpx;
  color: #6B7280;
  margin: 0 10rpx;
}
.track-meta {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}
.live-m { text-align: center; }
.live-mv {
  font-size: 36rpx;
  font-weight: 600;
  color: #0D9488;
  font-variant-numeric: tabular-nums;
}
.live-ml {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}
.track-extra {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 20rpx;
}
.btn-danger {
  background: #ffffff;
  color: #EF4444;
  border: 2rpx solid #FCA5A5;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}
