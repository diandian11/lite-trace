/* 轨迹详情页 */
.track-map {
  width: 100%;
  height: 560rpx;
  border-radius: 20rpx;
}
.track-meta {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}
.live-m { text-align: center; }
.live-mv {
  font-size: 36rpx;
  font-weight: 600;
  color: #0D9488;
  font-variant-numeric: tabular-nums;
}
.live-ml {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}
.track-extra {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 20rpx;
}
.btn-danger {
  background: #ffffff;
  color: #EF4444;
  border: 2rpx solid #FCA5A5;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}
