<view class="page" wx:if="{{rec}}">
  <map id="trackmap" class="track-map {{mapFull ? 'map-full' : ''}}" latitude="{{mapLat}}" longitude="{{mapLng}}"
       scale="15" polyline="{{poly}}" enable-zoom enable-scroll bindtap="toggleMapFull">
    <cover-view wx:if="{{mapFull}}" class="fm-top">
      <cover-view class="fm-exit" catchtap="toggleMapFull">✕ 退出全屏</cover-view>
      <cover-view class="fm-dist">{{rec.distance}} km</cover-view>
      <cover-view class="fm-time">{{rec.minutes}} 分钟 · {{pace}}/km{{rec.count ? ' · ' + rec.count + ' 步' : ''}}</cover-view>
    </cover-view>
  </map>
  <view class="map-tip" wx:if="{{!mapFull}}">点击地图可全屏查看 🗺</view>

  <view class="card">
    <view class="flex-row">
      <view class="card-title" style="margin-bottom:0;">{{rec.emoji}} {{rec.name}}</view>
      <view class="gap"></view>
      <view class="hint">{{dateLabel}}</view>
    </view>
    <view class="track-meta">
      <view class="live-m"><view class="live-mv">{{rec.distance}}</view><view class="live-ml">公里</view></view>
      <view class="live-m"><view class="live-mv">{{rec.minutes}}</view><view class="live-ml">分钟</view></view>
      <view class="live-m"><view class="live-mv">{{pace}}</view><view class="live-ml">配速/公里</view></view>
      <view class="live-m"><view class="live-mv">{{rec.count || '--'}}</view><view class="live-ml">步数</view></view>
      <view class="live-m"><view class="live-mv">−{{rec.kcal}}</view><view class="live-ml">千卡</view></view>
    </view>
    <view wx:if="{{rec.cadence}}" class="track-extra">平均步频 {{rec.cadence}} 步/分 · {{rec.intensity}}记录</view>
  </view>

  <button class="btn-danger" bindtap="del">🗑 删除记录</button>
</view>
