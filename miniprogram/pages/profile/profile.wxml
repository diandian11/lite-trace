<view class="page">
  <view class="card">
    <view class="card-title">👤 个人资料</view>
    <view class="form-row">
      <view class="form-label">昵称</view>
      <input class="form-input" value="{{name}}" bindinput="bindName" placeholder="怎么称呼你" />
    </view>
    <view class="form-row">
      <view class="form-label">性别</view>
      <picker class="form-picker" mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="bindGender">
        <view>{{genders[genderIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">身高(cm)</view>
      <input class="form-input" type="number" value="{{height}}" bindinput="bindHeight" />
    </view>
    <view class="form-row">
      <view class="form-label">出生年</view>
      <input class="form-input" type="number" value="{{birthYear}}" bindinput="bindBirth" />
    </view>
    <view class="form-row">
      <view class="form-label">目标体重</view>
      <input class="form-input" type="digit" value="{{targetWeight}}" bindinput="bindTarget" placeholder="kg" />
    </view>
    <button class="btn-main" bindtap="save">保存资料</button>
    <view class="hint" style="margin-top:16rpx;">资料用于计算基础代谢(BMR)，仅保存在本机</view>
  </view>

  <view class="card">
    <view class="flex-row">
      <view class="card-title" style="margin-bottom:0;">🏆 个人纪录 PB</view>
      <view class="gap"></view>
      <view class="hint">累计 {{stats.totalKm}} km · {{stats.totalKcal}} 千卡</view>
    </view>
    <view class="pb-grid">
      <view class="pb-cell" wx:for="{{pbItems}}" wx:key="label">
        <view class="pb-emoji">{{item.icon}}</view>
        <view class="pb-main">
          <view class="pb-label">{{item.label}}</view>
          <view class="pb-val">{{item.val}}<text class="pb-unit"> {{item.unit}}</text></view>
          <view class="pb-sub">{{item.sub}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="flex-row">
      <view class="card-title" style="margin-bottom:0;">🏅 成就徽章</view>
      <view class="gap"></view>
      <view class="hint">已点亮 {{doneCount}}/{{totalCount}}</view>
    </view>
    <view class="badges">
      <view class="badge {{item.done ? 'on' : ''}}" wx:for="{{badges}}" wx:key="id"
            bindtap="tapBadge" data-i="{{index}}">
        <view class="badge-icon">{{item.icon}}</view>
        <view class="badge-name">{{item.name}}</view>
        <view class="badge-pct">{{item.done ? '已点亮' : item.pct + '%'}}</view>
      </view>
    </view>
    <view class="hint" style="text-align:center;margin-top:16rpx;">点亮成就：当前连续 {{stats.streak}} 天 · 最长连续 {{stats.bestStreak}} 天 🔥</view>
  </view>

  <view class="card">
    <view class="btn-danger" bindtap="clearData">清空所有数据</view>
  </view>

  <view class="card about">
    <view style="font-weight:700;">轻迹 LiteTrace v0.1</view>
    <view class="hint" style="margin-top:6rpx;">每天轻一点 · 每步留痕迹</view>
    <view class="hint" style="margin-top:10rpx;">本工具数据仅供个人参考，不构成医疗建议</view>
  </view>
</view>
