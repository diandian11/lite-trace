<view class="page">

  <!-- 实时记录 -->
  <view class="card">
    <view class="flex-row">
      <view class="card-title" style="margin-bottom:0;">📡 实时记录</view>
      <view class="gap"></view>
      <view class="hint">{{liveOn ? (livePaused ? '已暂停' : (liveMode === 'outdoor' ? 'GPS 记录中…' : '计步中…')) : (liveMode === 'outdoor' ? '户外 GPS' : '室内计步')}}</view>
    </view>

    <!-- 模式切换 -->
    <view class="live-type-row">
      <view class="live-type {{liveMode === 'indoor' ? 'on' : ''}}" bindtap="setLiveMode" data-m="indoor">📱 室内计步</view>
      <view class="live-type {{liveMode === 'outdoor' ? 'on' : ''}}" bindtap="setLiveMode" data-m="outdoor">🗺 户外 GPS</view>
    </view>

    <!-- 室内 -->
    <block wx:if="{{liveMode === 'indoor'}}">
      <view wx:if="{{!liveOn}}">
        <view class="live-tip">点开始后带着手机走即可，快走/慢跑自动识别；切出小程序会自动暂停，回来点继续</view>
        <button class="btn-main" bindtap="startLive">▶ 开始记录</button>
      </view>
      <view wx:if="{{liveOn}}">
        <view class="live-auto">{{autoLabel}}</view>
        <view class="live-steps-wrap">
          <view class="live-steps">{{liveSteps}}</view>
          <view class="live-steps-unit">步</view>
        </view>
        <view class="live-meta">
          <view class="live-m"><view class="live-mv">{{liveTime}}</view><view class="live-ml">时长</view></view>
          <view class="live-m"><view class="live-mv">{{liveCadence}}</view><view class="live-ml">步频/分</view></view>
          <view class="live-m"><view class="live-mv">{{liveKcal}}</view><view class="live-ml">预估千卡</view></view>
        </view>
      </view>
    </block>

    <!-- 户外 -->
    <block wx:if="{{liveMode === 'outdoor'}}">
      <view class="live-type-row">
        <view class="live-type {{outTypeIndex === -1 ? 'on' : ''}}" bindtap="setOutType" data-i="-1">✨ 自动识别</view>
      </view>
      <view class="live-type-row">
        <view class="live-type live-type-sm {{outTypeIndex === 0 ? 'on' : ''}}" bindtap="setOutType" data-i="0">🚶 慢走</view>
        <view class="live-type live-type-sm {{outTypeIndex === 1 ? 'on' : ''}}" bindtap="setOutType" data-i="1">🏃 慢跑</view>
        <view class="live-type live-type-sm {{outTypeIndex === 2 ? 'on' : ''}}" bindtap="setOutType" data-i="2">💨 快跑</view>
        <view class="live-type live-type-sm {{outTypeIndex === 3 ? 'on' : ''}}" bindtap="setOutType" data-i="3">🚴 骑行</view>
      </view>
      <view wx:if="{{!liveOn}}">
        <view class="live-tip">默认✨自动识别（按近期速度+步频判定），也可手动锁定类型（运动中可随时切换）；锁屏揣兜里继续记录</view>
        <button class="btn-main" bindtap="startLive">▶ 开始户外记录</button>
      </view>
      <view wx:if="{{liveOn}}">
        <view class="live-auto">{{autoLabel}} · 点击地图可全屏</view>
        <map class="live-map {{mapFull ? 'map-full' : ''}}" latitude="{{mapLat}}" longitude="{{mapLng}}" scale="16"
             polyline="{{poly}}" show-location enable-zoom enable-scroll bindtap="toggleMapFull">
          <cover-view wx:if="{{mapFull}}" class="fm-top">
            <cover-view class="fm-exit" catchtap="toggleMapFull">✕ 退出全屏</cover-view>
            <cover-view class="fm-dist">{{outDist}} km</cover-view>
            <cover-view class="fm-time">{{liveTime}} · {{outPace}}/km · 🧭{{heading}}</cover-view>
          </cover-view>
          <cover-view wx:if="{{mapFull && holding}}" class="fm-progress">
            <cover-view class="fm-progress-track"><cover-view class="fm-progress-fill" style="width:{{finishProgress}}%"></cover-view></cover-view>
            <cover-view class="fm-progress-num">{{holdSecLeft}}s</cover-view>
          </cover-view>
          <cover-view wx:if="{{mapFull}}" class="fm-bottom">
            <cover-view class="fm-btn fm-btn-ghost" catchtap="togglePause">{{livePaused ? '▶ 继续' : '⏸ 暂停'}}</cover-view>
            <cover-view class="fm-btn fm-btn-main {{holding ? 'fm-holding' : ''}}" catchtouchstart="startHoldFinish" catchtouchend="cancelHoldFinish" catchtouchcancel="cancelHoldFinish" catchtap="holdFinishHint">
              <cover-view class="fm-edge" style="width:{{finishProgress}}%"></cover-view>
              <cover-view class="fm-hold-text">⏹ 停止保存</cover-view>
            </cover-view>
          </cover-view>
        </map>
        <view class="heat-legend" wx:if="{{!mapFull}}">
          <text class="hl-label">慢</text>
          <view class="hl-seg" style="background:#EF4444"></view>
          <view class="hl-seg" style="background:#F59E0B"></view>
          <view class="hl-seg" style="background:#EAB308"></view>
          <view class="hl-seg" style="background:#84CC16"></view>
          <view class="hl-seg" style="background:#10B981"></view>
          <text class="hl-label">快</text>
        </view>
        <view class="live-steps-wrap">
          <view class="live-steps">{{outDist}}</view>
          <view class="live-steps-unit">公里</view>
        </view>
        <view class="live-meta">
          <view class="live-m"><view class="live-mv">{{liveTime}}</view><view class="live-ml">时长</view></view>
          <view class="live-m"><view class="live-mv">{{outPace}}</view><view class="live-ml">配速/公里</view></view>
          <view class="live-m"><view class="live-mv">{{liveSteps}}</view><view class="live-ml">步数</view></view>
          <view class="live-m"><view class="live-mv">{{liveKcal}}</view><view class="live-ml">预估千卡</view></view>
        </view>
        <view class="live-heading">🧭 {{heading}}</view>
      </view>
    </block>

    <view wx:if="{{liveOn}}" class="live-btns">
      <button class="btn-ghost" bindtap="togglePause">{{livePaused ? '▶ 继续' : '⏸ 暂停'}}</button>
      <view class="gap"></view>
      <view class="btn-main live-finish hold-btn {{holding ? 'holding' : ''}}" bindtouchstart="startHoldFinish" bindtouchend="cancelHoldFinish" bindtouchcancel="cancelHoldFinish" bindtap="holdFinishHint">
        <view class="hold-edge" style="width:{{finishProgress}}%"></view>
        <view class="hold-text">⏹ 停止保存</view>
      </view>
    </view>
    <view wx:if="{{liveOn}}" class="hold-hint">
      <block wx:if="{{!holding}}">
        <view class="hold-hint-text">长按「停止保存」3 秒生效，防误触</view>
      </block>
      <block wx:else>
        <view class="hold-track"><view class="hold-track-fill" style="width:{{finishProgress}}%"></view></view>
        <view class="hold-hint-num">{{holdSecLeft}}s</view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🏃 手动打卡</view>
    <view class="form-row">
      <view class="form-label">类型</view>
      <picker class="form-picker" mode="selector" range="{{typeNames}}" value="{{typeIndex}}" bindchange="bindType">
        <view>{{typeNames[typeIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">时长(分钟)</view>
      <input class="form-input" type="number" value="{{minutes}}" bindinput="bindMinutes" placeholder="如 30" />
    </view>
    <view class="form-row">
      <view class="form-label">次数/组数</view>
      <input class="form-input" type="number" value="{{count}}" bindinput="bindCount" placeholder="选填，如 4 组" />
    </view>
    <view class="form-row">
      <view class="form-label">强度</view>
      <picker class="form-picker" mode="selector" range="{{intensityNames}}" value="{{intensityIndex}}" bindchange="bindIntensity">
        <view>{{intensityNames[intensityIndex]}}</view>
      </picker>
    </view>
    <button class="btn-main" bindtap="save">打卡 ✓</button>
  </view>

  <view class="card">
    <view class="flex-row">
      <view class="card-title" style="margin-bottom:0;">🗓 运动记录</view>
      <view class="gap"></view>
      <view class="date-nav">
        <view class="date-btn" bindtap="prevDay">‹</view>
        <view class="date-label">{{viewDate === todayStr ? '今天' : viewDate}}</view>
        <view class="date-btn {{viewDate >= todayStr ? 'off' : ''}}" bindtap="nextDay">›</view>
      </view>
    </view>
    <view class="hint" style="margin-top:12rpx;">合计 {{totalMin}} 分钟 · {{totalKcal}} 千卡</view>
    <view wx:if="{{records.length === 0}}" class="empty">{{viewDate === todayStr ? '今天还没运动，动起来 💪' : '这天没有运动记录'}}</view>
    <view wx:for="{{records}}" wx:key="ts" class="item">
      <view class="item-main" bindtap="openTrack" data-idx="{{item.idx}}">
        <view class="item-title">{{item.emoji}} {{item.name}} · {{item.minutes}} 分钟{{item.hasTrack ? ' 📍' : ''}}</view>
        <view class="item-sub">
          {{item.intensity}}{{item.distance ? ' · ' + item.distance + ' 公里' : ''}}{{item.count ? ' · ' + item.count + ' ' + (item.unit || '组') : ''}}{{item.hasTrack ? ' · 点看轨迹' : ''}}
        </view>
      </view>
      <view class="item-kcal">−{{item.kcal}}</view>
      <view class="item-del" bindtap="del" data-idx="{{item.idx}}">✕</view>
    </view>
  </view>
</view>
