/* 运动页：主要复用全局样式 */
.item-kcal { color: var(--lt-accent); }

/* ---- 实时记录 ---- */
.live-type-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}
.live-type {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.live-type.on {
  background: rgba(16, 185, 129, 0.10);
  color: #0D9488;
  border-color: #10B981;
  font-weight: 600;
}
.live-type-sm {
  font-size: 24rpx;
  padding: 16rpx 0;
}
.live-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.live-steps-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 32rpx 0 8rpx;
}
.live-steps {
  font-size: 120rpx;
  font-weight: 700;
  color: #0D9488;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.live-steps-unit {
  font-size: 30rpx;
  color: #6B7280;
  margin-left: 12rpx;
}

.live-meta {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 0 8rpx;
}
.live-m { text-align: center; }
.live-mv {
  font-size: 36rpx;
  font-weight: 600;
  color: #374151;
  font-variant-numeric: tabular-nums;
}
.live-ml {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.live-map {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
}
.map-full {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  border-radius: 0;
}

/* 全屏地图上的覆盖层（cover-view）：深色药丸底 + 高对比白字 */
.fm-top {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 32rpx 24rpx 32rpx;
  background: linear-gradient(rgba(17,24,39,0.82), rgba(17,24,39,0.45) 70%, rgba(0,0,0,0));
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.fm-exit {
  background: rgba(17,24,39,0.88);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
}
.fm-dist {
  background: rgba(17,24,39,0.72);
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 800;
  margin-top: 20rpx;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
}
.fm-time {
  background: rgba(17,24,39,0.66);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  margin-top: 14rpx;
  padding: 8rpx 22rpx;
  border-radius: 18rpx;
}
.fm-bottom {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 24rpx;
}
.fm-btn {
  position: relative;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 52rpx;
  border-radius: 44rpx;
}
.fm-holding {
  background: linear-gradient(135deg, #0EA371, #0B8F6B);
}
.fm-edge {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.95);
}
.fm-hold-text {
  position: relative;
  z-index: 1;
}

/* 全屏地图：按钮上方的进度条+倒数 */
.fm-progress {
  position: absolute;
  bottom: 170rpx;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fm-progress-track {
  width: 360rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 6rpx;
  overflow: hidden;
}
.fm-progress-fill {
  height: 100%;
  background: #ffffff;
}
.fm-progress-num {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(17, 24, 39, 0.7);
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  font-variant-numeric: tabular-nums;
}
.fm-btn-ghost {
  background: rgba(255,255,255,0.95);
  color: #0D9488;
}
.fm-btn-main {
  background: #10B981;
  color: #ffffff;
}

/* 速度热力图例 */
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 14rpx 0 0;
}
.hl-seg {
  width: 44rpx;
  height: 12rpx;
  border-radius: 6rpx;
}
.hl-label {
  font-size: 22rpx;
  color: #6B7280;
  margin: 0 10rpx;
}

.live-auto {
  text-align: center;
  font-size: 26rpx;
  color: #0D9488;
  font-weight: 600;
  margin-top: 20rpx;
}

.live-heading {
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  margin: 12rpx 0 4rpx;
  font-variant-numeric: tabular-nums;
}

.live-btns {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.live-btns .btn-ghost,
.live-btns .btn-main {
  flex: 1;
  margin: 0;
}
.live-btns .btn-ghost {
  height: 88rpx;
  line-height: 84rpx;
  padding: 0;
  box-sizing: border-box;
}
.btn-ghost {
  background: #ffffff;
  color: #0D9488;
  border: 2rpx solid #10B981;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.live-finish { margin-left: 20rpx !important; }

/* 长按停止保存：按钮保持简洁，进度体现在按钮底边细条 + 外部进度条 */
.hold-btn {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  box-sizing: border-box;
}
.hold-btn.holding {
  background: linear-gradient(135deg, #0EA371, #0B8F6B);
}
.hold-edge {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 0 6rpx 6rpx 0;
}
.hold-text {
  position: relative;
  z-index: 1;
}

/* 按钮下方的提示/进度区 */
.hold-hint {
  margin-top: 16rpx;
  min-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.hold-hint-text {
  font-size: 22rpx;
  color: #9CA3AF;
}
.hold-track {
  width: 300rpx;
  height: 10rpx;
  background: #E5E7EB;
  border-radius: 6rpx;
  overflow: hidden;
}
.hold-track-fill {
  height: 100%;
  background: linear-gradient(90deg, #34D399, #10B981);
  border-radius: 6rpx;
}
.hold-hint-num {
  font-size: 24rpx;
  color: #0D9488;
  font-weight: 700;
  min-width: 52rpx;
  font-variant-numeric: tabular-nums;
}

/* ---- 记录列表日期导航 ---- */
.date-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.date-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #0D9488;
  font-size: 32rpx;
  font-weight: 700;
}
.date-btn.off {
  color: #D1D5DB;
  background: #F9FAFB;
}
.date-label {
  font-size: 26rpx;
  color: #6B7280;
  min-width: 120rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}
