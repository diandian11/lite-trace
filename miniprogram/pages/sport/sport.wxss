/* 运动页：主要复用全局样式 */
.item-kcal { color: var(--lt-accent); }

/* ---- 实时记录 ---- */
.live-type-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}
.live-type {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.live-type.on {
  background: rgba(16, 185, 129, 0.10);
  color: #0D9488;
  border-color: #10B981;
  font-weight: 600;
}
.live-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.live-steps-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 32rpx 0 8rpx;
}
.live-steps {
  font-size: 120rpx;
  font-weight: 700;
  color: #0D9488;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.live-steps-unit {
  font-size: 30rpx;
  color: #6B7280;
  margin-left: 12rpx;
}

.live-meta {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 0 8rpx;
}
.live-m { text-align: center; }
.live-mv {
  font-size: 36rpx;
  font-weight: 600;
  color: #374151;
  font-variant-numeric: tabular-nums;
}
.live-ml {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

.live-map {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.live-heading {
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  margin: 12rpx 0 4rpx;
  font-variant-numeric: tabular-nums;
}

.live-btns {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.live-btns .btn-ghost,
.live-btns .btn-main {
  flex: 1;
  margin: 0;
}
.btn-ghost {
  background: #ffffff;
  color: #0D9488;
  border: 2rpx solid #10B981;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.live-finish { margin-left: 20rpx !important; }
